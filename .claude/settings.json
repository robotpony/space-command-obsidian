{
  "permissions": {
    "allow": ["Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)"],
    "deny": ["Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/commit-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-version-bump.sh"
          },
          {
            "type": "command",
            "command": "sh .claude/hooks/check-commit-message.sh"
          }
        ]
      }
    ]
  }
}
