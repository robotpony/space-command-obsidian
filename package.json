{
  "name": "space-command-obsidian",
  "version": "1.1.0",
  "description": "Space Command for Obsidian - an in-editor authoring companion for Space Command: tags, dates, handles, checklists and blocks",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "prebuild": "node scripts/check-version-bump.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "package": "scripts/package.sh"
  },
  "keywords": [],
  "author": "Bruce Alderson",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.10",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
